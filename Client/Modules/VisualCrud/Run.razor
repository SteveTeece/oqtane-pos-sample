@using Yosh.uwa.Models
@using Yosh.uwa.Services

@namespace Yosh.uwa.VisualCrud
@inherits ModuleBase
@inject IVisualCrudService CrudService
@inject NavigationManager NavigationManager

<div class="visual-crud-runtime">
    @if (_definition == null || _data == null)
    {
        <p><em>Loading...</em></p>
    }
    else
    {
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div class="d-flex align-items-center gap-2">
                <i class="@(string.IsNullOrWhiteSpace(_definition.Icon) ? "fa-solid fa-table" : _definition.Icon) fa-xl text-primary"></i>
                <div>
                    <h4 class="mb-0">@(_definition.MenuTitle ?? _definition.Name)</h4>
                    <small class="text-muted">@_definition.SourceSchema.@_definition.SourceTable · first 100 rows</small>
                </div>
            </div>
            <div class="d-flex gap-2">
                <button type="button" class="btn btn-success" @onclick="BeginAdd"><i class="fa-solid fa-plus me-1"></i>Add</button>
                <NavLink class="btn btn-secondary" href="@NavigateUrl()">Back</NavLink>
            </div>
        </div>

        @if (_editing)
        {
            <div class="card border-primary mb-3">
                <div class="card-header">@(_isNew ? "Add row" : "Edit row")</div>
                <div class="card-body row g-3">
                    @foreach (var column in EditableColumns)
                    {
                        <div class="col-md-6">
                            <label class="form-label">@(column.Label ?? column.Column) @if (column.IsRequired) { <span class="text-danger">*</span> }</label>
                            <input class="form-control" value="@Value(column.Column)" @oninput="@(args => _values[column.Column] = Convert.ToString(args.Value))" />
                        </div>
                    }
                </div>
                <div class="card-footer d-flex gap-2">
                    <button type="button" class="btn btn-success" @onclick="SaveRow">Save</button>
                    <button type="button" class="btn btn-secondary" @onclick="CancelEdit">Cancel</button>
                </div>
            </div>
        }

        <div class="table-responsive border rounded">
            <table class="table table-striped table-hover table-sm align-middle mb-0">
                <thead>
                    <tr>
                        <th style="width: 1%;">Actions</th>
                        @foreach (var column in _data.Columns)
                        {
                            <th>@(column.Label ?? column.Column)</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @if (_data.Rows.Count == 0)
                    {
                        <tr><td colspan="@(_data.Columns.Count + 1)" class="text-center text-muted p-4">No rows found.</td></tr>
                    }
                    @foreach (var row in _data.Rows)
                    {
                        <tr>
                            <td class="text-nowrap">
                                <button type="button" class="btn btn-outline-primary btn-sm me-1" title="Edit" @onclick="(() => BeginEdit(row))"><i class="fa-solid fa-pen"></i></button>
                                <button type="button" class="btn btn-outline-danger btn-sm" title="Delete" @onclick="(() => DeleteRow(row))"><i class="fa-solid fa-trash"></i></button>
                            </td>
                            @foreach (var column in _data.Columns)
                            {
                                <td>@Cell(row, column.DataKey)</td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    public override string Actions => "Run";
    public override string Title => _definition?.MenuTitle ?? "Visual CRUD";
    public override List<Resource> Resources => new() { new Stylesheet(ModulePath() + "Module.css") };

    private CrudDefinition _definition;
    private CrudDataResult _data;
    private bool _editing;
    private bool _isNew;
    private string _keyValue;
    private Dictionary<string, string> _values = new(StringComparer.OrdinalIgnoreCase);
    private List<CrudColumnDefinition> EditableColumns => _data?.Columns
        .Where(column => column.IsEditable && column.Schema == _definition.SourceSchema && column.Table == _definition.SourceTable)
        .ToList() ?? new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var id = int.Parse(PageState.QueryString["id"]);
            _definition = await CrudService.GetDefinitionAsync(id, ModuleState.ModuleId);
            if (_definition == null || !_definition.IsPublished)
            {
                AddModuleMessage("This CRUD definition is not published.", MessageType.Warning);
                return;
            }
            await Reload();
        }
        catch (Exception ex)
        {
            AddModuleMessage(ex.Message, MessageType.Error);
        }
    }

    private void BeginAdd()
    {
        _values = EditableColumns.ToDictionary(column => column.Column, _ => string.Empty, StringComparer.OrdinalIgnoreCase);
        _keyValue = null;
        _isNew = true;
        _editing = true;
    }

    private void BeginEdit(Dictionary<string, string> row)
    {
        _values = EditableColumns.ToDictionary(column => column.Column, column => Cell(row, column.DataKey), StringComparer.OrdinalIgnoreCase);
        _keyValue = Cell(row, $"{_definition.SourceTable}.{_definition.PrimaryKeyColumn}");
        _isNew = false;
        _editing = true;
    }

    private void CancelEdit()
    {
        _editing = false;
        _values.Clear();
    }

    private async Task SaveRow()
    {
        var request = Request(_keyValue, _values);
        var result = _isNew ? await CrudService.InsertAsync(request) : await CrudService.UpdateDataAsync(request);
        if (!result.Succeeded)
        {
            AddModuleMessage(result.Message, MessageType.Warning);
            return;
        }
        AddModuleMessage(result.Message, MessageType.Success);
        CancelEdit();
        await Reload();
    }

    private async Task DeleteRow(Dictionary<string, string> row)
    {
        var key = Cell(row, $"{_definition.SourceTable}.{_definition.PrimaryKeyColumn}");
        var result = await CrudService.DeleteDataAsync(Request(key, new Dictionary<string, string>()));
        if (!result.Succeeded)
        {
            AddModuleMessage(result.Message, MessageType.Warning);
            return;
        }
        await Reload();
    }

    private CrudDataRequest Request(string key, Dictionary<string, string> values) => new()
    {
        ModuleId = ModuleState.ModuleId,
        DefinitionId = _definition.CrudDefinitionId,
        KeyValue = key,
        Values = values
    };

    private async Task Reload() => _data = await CrudService.GetDataAsync(_definition.CrudDefinitionId, ModuleState.ModuleId);
    private string Value(string column) => _values.TryGetValue(column, out var value) ? value : string.Empty;
    private static string Cell(Dictionary<string, string> row, string key) => row.TryGetValue(key, out var value) ? value ?? string.Empty : string.Empty;
}
